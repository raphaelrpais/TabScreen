{
  "manifest_version": 3,
  "name": "TabScreen",
  "description": "Keeps video/player fullscreen inside the browser viewport instead of taking over the entire display.",
  "version": "0.1.0",
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
